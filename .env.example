# Payhip product secret key from the product edit page → Licence keys.
# Server-only. Never prefix with NEXT_PUBLIC_.
PAYHIP_PRODUCT_SECRET_KEY=

# Optional Payhip product link / product key for PropertyIQ (for example mVT0).
PAYHIP_PROPERTYIQ_PRODUCT_LINK=

# Optional activation cap. Payhip usage is incremented only on a genuine new activation.
PAYHIP_MAX_ACTIVATIONS=2

# Long random secret used to encrypt and authenticate PropertyIQ access cookies.
# Generate with: openssl rand -base64 48
PROPERTYIQ_SESSION_SECRET=

# Optional. Bearer token for POST /api/access/support-reset (decrements Payhip usage).
PROPERTYIQ_SUPPORT_RESET_TOKEN=

# Gumroad product ID from the product content page → Licence key block.
# Server-only. Used with POST https://api.gumroad.com/v2/licenses/verify.
# No Gumroad API token is required for licence verification.
GUMROAD_PROPERTYIQ_PRODUCT_ID=

# Public marketplace product pages shown on /access. Safe to prefix with NEXT_PUBLIC_.
# These are purchase URLs only — they are not licence secrets.
NEXT_PUBLIC_GUMROAD_PRODUCT_URL=https://meridianproducts.gumroad.com/l/PortfolioIQ
NEXT_PUBLIC_PAYHIP_PRODUCT_URL=https://payhip.com/b/4kT9y

# Vercel Postgres / Neon connection string supplied by the Vercel Storage
# integration. In the Vercel dashboard:
#   Project → Storage → Postgres → Create / Connect
#   then Project → Settings → Environment Variables.
# Production, Preview and Development should receive POSTGRES_URL
# (and usually POSTGRES_URL_NON_POOLING). DATABASE_URL is accepted as a fallback.
# Server-only. Never prefix with NEXT_PUBLIC_.
POSTGRES_URL=
DATABASE_URL=

# Server-only secret that authorises tester-code CLI commands
# (npm run tester:create | tester:list | tester:revoke) and
# GET/POST /api/admin/tester-codes.
# Generate with: openssl rand -base64 48
# Never prefix with NEXT_PUBLIC_. Do not commit the real value.
PROPERTYIQ_TESTER_ADMIN_SECRET=
